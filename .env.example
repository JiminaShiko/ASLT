# Copy this file to .env in the repository root (Backend/.env works too, but do
# not create both) and fill in the values. .env is git-ignored: never commit
# real keys.

# --- AgentMail ---------------------------------------------------------------
# The backend agent's own inbox (Backend/agent_mail.py). Get the API key from
# https://console.agentmail.to -> API Keys.
AGENTMAIL_API_KEY=
# Signing secret (whsec_...) of the AgentMail webhook pointed at
# POST /api/agent/email/webhook with the "message.received" event.
AGENTMAIL_WEBHOOK_SECRET=
# --- Pusher Channels ---------------------------------------------------------
# Live admin session monitor (Backend/config/realtime.py). Create a Channels app
# at https://dashboard.pusher.com -> App Keys and paste the four values.
# Leave them blank to keep the 30-second polling fallback.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
# Optional; the monitor uses this private channel by default.
PUSHER_CHANNEL=private-admin-sessions
