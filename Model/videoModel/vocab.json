{
  "version": 3,
  "enabled_batches": [1, 2, 3],
  "enabled_words": [
    "eat", "family", "friend", "good", "hello", "help", "name", "school",
    "drink", "thanks", "love", "bye", "sorry", "yes", "no", "please",
    "bad", "home", "me", "you", "what", "where", "want", "need", "go",
    "come", "stop", "more", "water", "understand", "now", "today",
    "work", "finish", "sleep", "bathroom", "hungry", "when", "why", "how"
  ],
  "enabled_words_note": "daily-communication core: the retained subset of batches 1-3 the shipped model is trained on. Empty list = every enabled batch.",
  "dataset": "ASL Citizen (splits/train.csv, splits/val.csv, splits/test.csv)",
  "gloss_matching": "exact raw Gloss string from the official split CSVs",
  "how_to_read": [
    "word      : the label the recogniser prints",
    "batch     : 1 = original twenty, 2 = communication essentials, 3 = daily needs, 4 = foods, places, people, transport, and objects",
    "external_glosses: exact PopSign directory names, never invented Citizen glosses",
    "I and me share one ME class; written English forms are not extra visual classes",
    "glosses   : the ASL Citizen Gloss values folded into this word. Numeric",
    "            suffixes (EAT1 / EAT2) are separate ASL-LEX entries: they are",
    "            different realisations of the same English word, so merging",
    "            them doubles within-class variation. Merge only if you accept",
    "            that; the table in reports/vocab.md shows the per-gloss counts.",
    "min_videos: warn if fewer official train videos than this",
    "status    : ok | flag | unavailable - informational, re-checked by src/vocab.py"
  ],
  "words": [
    {"word": "eat",     "batch": 1, "glosses": ["EAT1", "EAT2"],          "external_glosses": ["eat"], "min_videos": 15, "note": "two different signs (B_02_002, B_03_082), merged as one word"},
    {"word": "family",  "batch": 1, "glosses": ["FAMILY"],                "min_videos": 15},
    {"word": "friend",  "batch": 1, "glosses": ["FRIEND"],                "external_glosses": ["friend"], "min_videos": 15},
    {"word": "good",    "batch": 1, "glosses": ["GOOD"], "external_glosses": ["good"],                  "min_videos": 15},
    {"word": "hello",   "batch": 1, "glosses": ["HELLO"],                 "external_glosses": ["hello"], "min_videos": 15},
    {"word": "help",    "batch": 1, "glosses": ["HELP"],                  "external_glosses": ["help"], "min_videos": 15},
    {"word": "name",    "batch": 1, "glosses": ["NAME"],                  "min_videos": 15},
    {"word": "sad",     "batch": 1, "glosses": ["SAD"],                   "external_glosses": ["sad"], "min_videos": 15},
    {"word": "school",  "batch": 1, "glosses": ["SCHOOL"],                "min_videos": 15},
    {"word": "drink",   "batch": 1, "glosses": ["DRINK1", "DRINK2"],      "external_glosses": ["drink"], "min_videos": 15, "note": "two different signs (B_02_012, K_03_092), merged as one word"},
    {"word": "thanks",  "batch": 1, "glosses": ["THANKYOU"], "external_glosses": ["thankyou"],              "min_videos": 15, "note": "THANKSGIVING is a different word and is NOT merged"},
    {"word": "love",    "batch": 1, "glosses": ["LOVE"],                  "external_glosses": ["love"], "min_videos": 15},
    {"word": "bye",     "batch": 1, "glosses": ["BYE"], "external_glosses": ["bye"],                   "min_videos": 15},
    {"word": "sorry",   "batch": 1, "glosses": ["SORRY"],                 "min_videos": 15},
    {"word": "yes",     "batch": 1, "glosses": ["YES"],                   "external_glosses": ["yes"], "min_videos": 15},
    {"word": "no",      "batch": 1, "glosses": ["NO"],                    "external_glosses": ["no"], "min_videos": 15, "note": "NOON1 / NOON2 are 'noon', not 'no'"},
    {"word": "happy",   "batch": 1, "glosses": ["HAPPY"], "external_glosses": ["happy"],                 "min_videos": 15},
    {"word": "please",  "batch": 1, "glosses": ["PLEASE"], "external_glosses": ["please"],                "min_videos": 15},
    {"word": "bad",     "batch": 1, "glosses": ["BAD"],                   "external_glosses": ["bad"], "min_videos": 15},
    {"word": "home",    "batch": 1, "glosses": ["HOME"],                  "external_glosses": ["home"], "min_videos": 15, "note": "HOMEWORK is a different sign and is NOT merged"},

    {"word": "me",          "batch": 2, "glosses": ["ME"],                "min_videos": 15, "note": "MEET / MELT / MESS are different words"},
    {"word": "my",          "batch": 2, "glosses": ["MY"],                "min_videos": 15},
    {"word": "you",         "batch": 2, "glosses": ["YOU"],               "min_videos": 15, "note": "YOUNG / YOURSELF are different words"},
    {"word": "your",        "batch": 2, "glosses": ["YOUR"],              "min_videos": 15},
    {"word": "what",        "batch": 2, "glosses": ["WHAT1", "WHAT2"],    "external_glosses": ["what"], "min_videos": 15, "note": "W.H.A.T (fingerspelled) excluded by default; add it here if you want it folded in"},
    {"word": "where",       "batch": 2, "glosses": ["WHERE"],             "external_glosses": ["where"], "min_videos": 15, "note": "WHOLE is a different word"},
    {"word": "who",         "batch": 2, "glosses": ["WHO"],               "external_glosses": ["who"], "min_videos": 15},
    {"word": "want",        "batch": 2, "glosses": ["WANT1", "WANT2"],    "min_videos": 15, "note": "DONTWANT is a different sign"},
    {"word": "need",        "batch": 2, "glosses": ["NEED"],              "min_videos": 15, "note": "DONTNEED / NEEDLE are different signs"},
    {"word": "like",        "batch": 2, "glosses": ["LIKE"],              "external_glosses": ["like"], "min_videos": 15},
    {"word": "go",          "batch": 2, "glosses": ["GO"],                "external_glosses": ["go"], "min_videos": 15, "note": "GOAL / GOD / GOAT / GONE / GO_AHEAD are different signs"},
    {"word": "come",        "batch": 2, "glosses": ["COME"],              "min_videos": 15, "note": "COMEHERE / COMEOUT are different signs"},
    {"word": "stop",        "batch": 2, "glosses": ["STOP"],              "external_glosses": ["stop"], "min_videos": 15, "note": "STOPWATCH excluded; FINISH is a different sign"},
    {"word": "more",        "batch": 2, "glosses": ["MORE"],              "external_glosses": ["more"], "min_videos": 15},
    {"word": "water",       "batch": 2, "glosses": ["WATER"],             "external_glosses": ["water"], "min_videos": 15, "note": "WATERDROP / WATERSKI are different signs"},
    {"word": "food",        "batch": 2, "glosses": [],                    "min_videos": 15, "status": "unavailable", "note": "ASL Citizen has no FOOD gloss at all (checked every one of the 2,731 glosses). EAT and MEAT are different signs, so there is nothing to merge into. Dropped unless another public source is added."},
    {"word": "understand",  "batch": 2, "glosses": ["UNDERSTAND"],        "min_videos": 15, "note": "NOTUNDERSTAND / MISUNDERSTAND are different signs"},
    {"word": "now",         "batch": 2, "glosses": ["NOW"],               "external_glosses": ["now"], "min_videos": 15, "note": "NOTYET / NOWHERE are different signs"},
    {"word": "today",       "batch": 2, "glosses": ["TODAY"],             "external_glosses": ["today"], "min_videos": 15},
    {"word": "work",        "batch": 2, "glosses": ["WORK"],              "external_glosses": ["work"], "min_videos": 15, "note": "WORKOUT / WORKSHOP are different signs"},

    {"word": "wait",        "batch": 3, "glosses": ["WAIT"],       "external_glosses": ["wait"], "min_videos": 13},
    {"word": "finish",      "batch": 3, "glosses": ["FINISH"],     "external_glosses": ["finish"], "min_videos": 15},
    {"word": "sleep",       "batch": 3, "glosses": ["SLEEP"],      "external_glosses": ["sleep"], "min_videos": 13},
    {"word": "bathroom",    "batch": 3, "glosses": ["BATHROOM"],   "external_glosses": ["bathroom"], "min_videos": 14},
    {"word": "hungry",      "batch": 3, "glosses": ["HUNGRY"],     "external_glosses": ["hungry"], "min_videos": 15},
    {"word": "thirsty",     "batch": 3, "glosses": ["THIRSTY"],    "external_glosses": ["thirsty"], "min_videos": 14},
    {"word": "when",        "batch": 3, "glosses": ["WHEN"],       "external_glosses": ["when"], "min_videos": 14},
    {"word": "why",         "batch": 3, "glosses": ["WHY"],        "external_glosses": ["why"], "min_videos": 14},
    {"word": "how",         "batch": 3, "glosses": ["HOW1"],       "external_glosses": ["how"], "min_videos": 17, "note": "One verified Citizen source entry; no claim this is the only ASL variant"},
    {"word": "apple",       "batch": 3, "glosses": ["APPLE"],      "external_glosses": ["apple"], "min_videos": 17},
    {"word": "bread",       "batch": 3, "glosses": ["BREAD"],      "min_videos": 14},
    {"word": "chicken",     "batch": 3, "glosses": [], "external_glosses": ["chicken"], "min_videos": 0, "note": "PopSign only: no Citizen CHICKEN gloss; HEN is not substituted. Evaluated separately on PopSign signers."},
    {"word": "tomorrow",    "batch": 3, "glosses": ["TOMORROW"],   "external_glosses": ["tomorrow"], "min_videos": 16},
    {"word": "sick",        "batch": 3, "glosses": ["SICK"],       "external_glosses": ["sick"], "min_videos": 14},
    {"word": "hurt",        "batch": 3, "glosses": ["HURT"],       "external_glosses": ["hurt"], "min_videos": 14},
    {"word": "doctor",      "batch": 3, "glosses": ["DOCTOR1"],    "external_glosses": ["doctor"], "min_videos": 13, "note": "One Citizen variant; no automatic mapping from another corpus"},
    {"word": "medicine",    "batch": 3, "glosses": ["MEDICINE"],   "min_videos": 15},

    {"word": "meat",       "batch": 4, "glosses": ["MEAT1", "MEAT2"], "min_videos": 30, "note": "Two ASL-LEX variants grouped under the English word meat; increases within-class variation."},
    {"word": "vegetable",  "batch": 4, "glosses": ["VEGETABLE"],       "min_videos": 14},
    {"word": "milk",       "batch": 4, "glosses": ["MILK1", "MILK2"], "min_videos": 28, "note": "Two ASL-LEX variants grouped under milk."},
    {"word": "coffee",     "batch": 4, "glosses": ["COFFEE"],          "min_videos": 15},
    {"word": "tea",        "batch": 4, "glosses": ["TEA"],             "min_videos": 15},
    {"word": "fruit",      "batch": 4, "glosses": ["FRUIT"],           "min_videos": 15},
    {"word": "fish",       "batch": 4, "glosses": ["FISH"],            "min_videos": 14},
    {"word": "egg",        "batch": 4, "glosses": ["EGG"],             "min_videos": 15},
    {"word": "potato",     "batch": 4, "glosses": ["POTATO"],          "min_videos": 15},
    {"word": "carrot",     "batch": 4, "glosses": ["CARROT1"],         "min_videos": 14},
    {"word": "tomato",     "batch": 4, "glosses": ["TOMATO"],          "min_videos": 17},
    {"word": "orange",     "batch": 4, "glosses": ["ORANGE"],          "min_videos": 14},

    {"word": "park",       "batch": 4, "glosses": ["PARK"],            "min_videos": 15},
    {"word": "hospital",   "batch": 4, "glosses": ["HOSPITAL1", "HOSPITAL2"], "min_videos": 28, "note": "Two ASL-LEX variants grouped under hospital."},
    {"word": "restaurant", "batch": 4, "glosses": ["RESTAURANT"],      "min_videos": 15},
    {"word": "library",    "batch": 4, "glosses": ["LIBRARY"],         "min_videos": 15},
    {"word": "hotel",      "batch": 4, "glosses": ["HOTEL"],           "min_videos": 15},
    {"word": "church",     "batch": 4, "glosses": ["CHURCH"],          "min_videos": 16},
    {"word": "bank",       "batch": 4, "glosses": ["BANK"],            "min_videos": 14},
    {"word": "office",     "batch": 4, "glosses": ["OFFICE"],          "min_videos": 13},

    {"word": "police",     "batch": 4, "glosses": ["POLICEMAN1", "POLICEMAN2"], "min_videos": 28, "note": "Citizen labels POLICEMAN; two variants grouped under police."},
    {"word": "nurse",      "batch": 4, "glosses": ["NURSE"],           "min_videos": 15},
    {"word": "teacher",    "batch": 4, "glosses": ["TEACHER"],         "min_videos": 14},
    {"word": "mother",     "batch": 4, "glosses": ["MOTHER"],          "min_videos": 14},
    {"word": "father",     "batch": 4, "glosses": ["FATHER"],          "min_videos": 14},
    {"word": "child",      "batch": 4, "glosses": ["CHILD"],           "min_videos": 16},
    {"word": "man",        "batch": 4, "glosses": ["MAN"],             "min_videos": 15},

    {"word": "car",        "batch": 4, "glosses": ["CAR"],             "min_videos": 15},
    {"word": "boat",       "batch": 4, "glosses": ["BOAT"],            "min_videos": 16},
    {"word": "bicycle",    "batch": 4, "glosses": ["BICYCLE"],         "min_videos": 15},
    {"word": "airplane",   "batch": 4, "glosses": ["AIRPLANE"],        "min_videos": 12},
    {"word": "bus",        "batch": 4, "glosses": ["BUS"],             "min_videos": 13},
    {"word": "train",      "batch": 4, "glosses": ["TRAIN"],           "min_videos": 14},
    {"word": "motorcycle", "batch": 4, "glosses": ["MOTORCYCLE"],      "min_videos": 14},

    {"word": "phone",      "batch": 4, "glosses": ["PHONE", "CELLPHONE"], "min_videos": 26, "note": "Phone and cellphone glosses grouped under the everyday word phone."},
    {"word": "money",      "batch": 4, "glosses": ["MONEY1", "MONEY2"], "min_videos": 28, "note": "Two ASL-LEX variants grouped under money."},
    {"word": "book",       "batch": 4, "glosses": ["BOOK"],            "min_videos": 15},
    {"word": "key",        "batch": 4, "glosses": ["KEY"],             "min_videos": 15}
  ],
  "extra_classes": {
    "REST": {
      "what": "idle start/end frames of the same videos, trimmed by src/extract.py",
      "cap_train": 600, "cap_val": 150, "cap_test": 300,
      "min_frames": 4, "max_frames": 96
    },
    "OTHER": {
      "what": "capped deterministic sample of non-vocabulary signs, official split only",
      "cap_train": 600, "cap_val": 150, "cap_test": 300,
      "per_gloss_max": 2, "seed": 20261116
    }
  },
  "excluded_glosses_deliberately": [
    "Sign Language MNIST: not used anywhere in this project",
    "WLASL: no unverified video links or replacement signs are used",
    "FOOD: no exact Citizen FOOD gloss; use verified individual foods instead of relabelling EAT",
    "STATION: no verified station gloss in the available ASL Citizen splits; police is a separate sign",
    "HEN: not automatically relabelled as chicken",
    "PopSign playgroundschool: not a verified substitute for SCHOOL"
  ]
}
